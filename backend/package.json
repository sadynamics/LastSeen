{
  "name": "lastseen-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/workers/index.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.4.0",
    "@aws-sdk/client-s3": "^3.621.0",
    "@hapi/boom": "^10.0.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "fastify-plugin": "^4.5.1",
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "@sentry/node": "^8.30.0",
    "@whiskeysockets/baileys": "^6.7.8",
    "apn": "^2.2.0",
    "apple-signin-auth": "^1.7.6",
    "bullmq": "^5.13.2",
    "dotenv-flow": "^4.1.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.3",
    "libphonenumber-js": "^1.11.10",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4",
    "ulidx": "^2.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
