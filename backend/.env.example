# ----- Server -----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ----- Database -----
DATABASE_URL=postgresql://lastseen:lastseen_dev@localhost:5432/lastseen?schema=public

# ----- Redis (BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- Object storage for Baileys auth state -----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=lastseen
S3_SECRET_ACCESS_KEY=lastseen_dev
S3_BUCKET_BAILEYS=baileys-auth
S3_FORCE_PATH_STYLE=true

# ----- JWT (our own session token) -----
JWT_SECRET=change_me_to_a_long_random_string_for_dev_only
JWT_ISSUER=lastseen.app
JWT_AUDIENCE=lastseen-ios

# ----- Sign in with Apple -----
APPLE_BUNDLE_ID=collabrainstech.LastSeen
APPLE_TEAM_ID=KLM566N289

# ----- Apple App Store Server API (StoreKit 2 server validation) -----
# .p8 file contents, base64-encoded (single line, no newlines)
APPLE_INAPP_KEY_ID=
APPLE_INAPP_ISSUER_ID=
APPLE_INAPP_PRIVATE_KEY_BASE64=
APPLE_INAPP_ENVIRONMENT=Sandbox

# ----- APNs -----
# .p8 push key, base64-encoded
APNS_KEY_ID=
APNS_TEAM_ID=KLM566N289
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=collabrainstech.LastSeen
APNS_ENVIRONMENT=development

# ----- Admin -----
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change_me

# ----- Sentry -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
